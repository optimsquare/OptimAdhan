<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives access to Windows location services (Windows.Devices.Geolocation). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon (NotifyIcon); WPF has none built in. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OptimAdhan</AssemblyName>
    <RootNamespace>OptimAdhan.App</RootNamespace>
    <ApplicationIcon>Assets\Brand\optimadhan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>OptimAdhan</Product>
    <Company>Optim Square LLC</Company>
    <Copyright>© Optim Square LLC</Copyright>
    <Description>OptimAdhan — Your Daily Prayer Companion</Description>
    <Version>0.3.1</Version>
    <!-- The app is English-only: skip the framework's localized resource folders (about 13 languages each for WPF and WinForms). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Fluent theme in WPF is flagged experimental (WPF0001) but supported in .NET 10. -->
    <!-- WFO0003: DPI awareness is declared in app.manifest because WPF, not WinForms, owns the windows. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid ambiguities (Application, MessageBox, ...) between WPF and WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptimAdhan.Core\OptimAdhan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Audio and fonts ship as loose files so licensed recordings can replace them without a rebuild. -->
    <Content Include="Assets\Audio\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Official brand artwork copied from assets/: app icon, dimensional symbol, tray crescents. -->
    <Resource Include="Assets\Brand\*.ico" />
    <Resource Include="Assets\Brand\symbol.png" />
    <!-- Zelle QR code: an unmodified copy of the web app's public/ZelleCode.png. Never regenerate it. -->
    <Resource Include="Assets\Support\zelle-qr.png" />
    <Resource Include="Assets\Fonts\Amiri-Regular.ttf" />
    <!-- Amiri 1.003 (SIL OFL 1.1): the licence must travel with the font. -->
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
