<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:OptimAdhan.App.Controls">
    <!--
      OptimAdhan — Premium Midnight design system.
      Palette from assets/references/brand-moodboard.png, extended with emerald and champagne.
      Everything here is static brushes and templates: no effects, no looping animation.
    -->

    <!-- ── Palette ───────────────────────────────────────────── -->
    <Color x:Key="MidnightColor">#07142D</Color>
    <Color x:Key="DeepColor">#0B1B3A</Color>
    <Color x:Key="SurfaceColor">#112644</Color>
    <Color x:Key="SurfaceHighColor">#16305A</Color>
    <Color x:Key="GoldColor">#FFD65A</Color>
    <Color x:Key="GoldDeepColor">#C9962E</Color>
    <Color x:Key="ChampagneColor">#E9CF96</Color>
    <Color x:Key="EmeraldColor">#2BB58A</Color>
    <Color x:Key="EmeraldSoftColor">#8FE6C6</Color>
    <Color x:Key="IvoryColor">#F6F1E7</Color>
    <Color x:Key="TextSecondaryColor">#BCC1CB</Color>
    <Color x:Key="TextTertiaryColor">#8E96A6</Color>
    <Color x:Key="CoralColor">#FF9C8A</Color>

    <SolidColorBrush x:Key="MidnightBrush" Color="{StaticResource MidnightColor}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="ChampagneBrush" Color="{StaticResource ChampagneColor}" />
    <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />
    <SolidColorBrush x:Key="EmeraldSoftBrush" Color="{StaticResource EmeraldSoftColor}" />
    <SolidColorBrush x:Key="IvoryBrush" Color="{StaticResource IvoryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#33FFD65A" />
    <SolidColorBrush x:Key="GoldFaintBrush" Color="#14FFD65A" />
    <SolidColorBrush x:Key="EmeraldFaintBrush" Color="#292BB58A" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="InputFillBrush" Color="#99071430" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#12FFFFFF" />
    <!-- Brushes the legacy code still refers to. -->
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource MidnightColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- Window ground: midnight with soft atmospheric light, no image. -->
    <RadialGradientBrush x:Key="WindowGroundBrush" Center="0.72,-0.05" GradientOrigin="0.72,-0.05" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#2A1E3E78" Offset="0" />
        <GradientStop Color="#001E3E78" Offset="1" />
    </RadialGradientBrush>

    <!-- Glass card: translucent surface with a brighter top edge. -->
    <LinearGradientBrush x:Key="CardFillBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#E0132A4E" Offset="0" />
        <GradientStop Color="#D90D1F42" Offset="1" />
    </LinearGradientBrush>
    <!-- Glass edge: a bright specular top edge fading to a faint emerald-tinted bottom. -->
    <LinearGradientBrush x:Key="CardStrokeBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.45" />
        <GradientStop Color="#1F2BB58A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardStrokeHoverBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="0.45" />
        <GradientStop Color="#402BB58A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F01E3E78" Offset="0" />
        <GradientStop Color="#F00F2550" Offset="0.55" />
        <GradientStop Color="#F00A3A3A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFD65A" Offset="0" />
        <GradientStop Color="#33FFD65A" Offset="0.5" />
        <GradientStop Color="#552BB58A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NextCardFillBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#40FFD65A" Offset="0" />
        <GradientStop Color="#1AFFD65A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C9962E" Offset="0" />
        <GradientStop Color="#FFD65A" Offset="1" />
    </LinearGradientBrush>

    <!-- Eight-point star (khatam) motif, used at very low opacity behind hero cards. -->
    <DrawingBrush x:Key="KhatamPatternBrush" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Stretch="None"
                  RenderOptions.CachingHint="Cache" RenderOptions.CacheInvalidationThresholdMinimum="0.5" RenderOptions.CacheInvalidationThresholdMaximum="2">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M22,4 L26.5,17.5 L40,22 L26.5,26.5 L22,40 L17.5,26.5 L4,22 L17.5,17.5 Z M22,11 L33,22 L22,33 L11,22 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource GoldBrush}" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ── Override the Windows accent (it was leaking purple into controls) ── -->
    <Color x:Key="SystemAccentColor">#FFD65A</Color>
    <Color x:Key="SystemAccentColorLight1">#FFE08A</Color>
    <Color x:Key="SystemAccentColorLight2">#FFE9A8</Color>
    <Color x:Key="SystemAccentColorLight3">#FFF2C9</Color>
    <Color x:Key="SystemAccentColorDark1">#E6B93F</Color>
    <Color x:Key="SystemAccentColorDark2">#C9962E</Color>
    <Color x:Key="SystemAccentColorDark3">#9C7220</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFD65A" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FFD65A" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFFD65A" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD65A" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFE08A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#07142D" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F6F1E7" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#BCC1CB" />

    <!-- ── Typography ─────────────────────────────────────────── -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ArabicFont">pack://application:,,,/Assets/Fonts/#Amiri</FontFamily>

    <!--
      Arabic names: Amiri (a classical Naskh face), right-to-left, tagged as Arabic for
      correct shaping. Amiri's tall ascenders and deep descenders (1.12 / 0.63 em) would
      otherwise inflate rows, so line height is fixed relative to the size used.
    -->
    <Style x:Key="ArabicText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="Foreground" Value="{StaticResource ChampagneBrush}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="Language" Value="ar" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ChampagneBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ── Surfaces ───────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeroFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeroStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="#33061026" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ── Focus: a gold ring, visible on every focusable control ── -->
    <Style x:Key="GoldFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────── -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassFillPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource GlassButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Foreground" Value="{StaticResource MidnightBrush}" />
        <Setter Property="Background" Value="{StaticResource GoldBrush}" />
        <Setter Property="BorderBrush" Value="#FFE7A2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE08A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E6B93F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- ── Toggle switch (all CheckBoxes are on/off settings) ──── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="#8CF6F1E7" BorderThickness="1.5">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="#C8F6F1E7">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource EmeraldBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource EmeraldBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource IvoryBrush}" />
                            <Setter TargetName="Thumb" Property="Width" Value="18" />
                            <Setter TargetName="Thumb" Property="Height" Value="18" />
                            <Setter TargetName="Thumb" Property="Margin" Value="2,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Segmented control (RadioButtons sharing a GroupName) ── -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="16,7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Filter chips (Ramadan Ashra) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="17" Padding="14,0" MinHeight="34" Background="{StaticResource GlassFillBrush}"
                            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8CFFD65A" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar navigation item. Tag holds the icon geometry; on the icon rail
         (c:Shell.IsCompact) the label hides and becomes a tooltip. ── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="MainNav" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{StaticResource GoldBrush}" Opacity="0" />
                        <StackPanel x:Name="Row" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                            <Path x:Name="Icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18"
                                  Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldFaintBrush}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="c:Shell.IsCompact" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Row" Property="Margin" Value="0" />
                            <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Icon" Property="Width" Value="20" />
                            <Setter TargetName="Icon" Property="Height" Value="20" />
                            <Setter Property="ToolTipService.IsEnabled" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Chrome icon button (sidebar toggle, title-bar tools). Content is a Path. ── -->
    <Style x:Key="ChromeIconButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldFaintBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Quick toggle on the icon rail: Tag holds the icon; a slash marks "off". ── -->
    <Style x:Key="RailToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <Grid Width="18" Height="18">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Line x:Name="Slash" X1="1" Y1="1" X2="17" Y2="17" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Slash" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource EmeraldFaintBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource EmeraldSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Tables (DataGrid is outside the Fluent theme, so it is styled fully here) ── -->
    <Style x:Key="MidnightGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource ChampagneBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TimeHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TimeCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="TableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
        <Setter Property="BorderBrush" Value="#0DFFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#08FFFFFF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#14FFFFFF" />
            </Trigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldSoftBrush}" />
                <Setter Property="BorderBrush" Value="#8CFFD65A" />
                <Setter Property="BorderThickness" Value="0,1,0,1" />
                <Setter Property="Foreground" Value="#FFF4D0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Inputs: keep Fluent's controls but size them consistently ── -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="MaxWidth" Value="320" />
    </Style>

