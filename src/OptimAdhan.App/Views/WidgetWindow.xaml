<Window x:Class="OptimAdhan.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimAdhan widget" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" Foreground="{StaticResource IvoryBrush}" FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" ThemeMode="None">
    <!--
      Non-layered window: Windows 11 draws real frosted acrylic behind it (GPU, no app cost).
      The tint layer below keeps text readable on bright wallpapers; its strength is the
      "Glass tint" setting. Without system backdrops the tint becomes fully opaque.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="15" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFD65A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFD65A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One prayer in the bottom strip; a hairline separates it from the previous one. -->
        <DataTemplate x:Key="StripItem">
            <Border x:Name="Sep" BorderBrush="#24FFFFFF" BorderThickness="1,0,0,0" Padding="0,2">
                <Border x:Name="Pill" CornerRadius="10" Margin="6,0" Padding="6,6" Background="Transparent">
                    <Border.ToolTip>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Arabic, Mode=OneWay}" FontFamily="{StaticResource ArabicFont}" FontSize="15" /><Run Text="  ·  " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                        </TextBlock>
                    </Border.ToolTip>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" Foreground="#D9F6F1E7" />
                        <TextBlock x:Name="Time" Text="{Binding TimeText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Pill" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="#17FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="Sep" Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Name" Property="Opacity" Value="0.7" />
                    <Setter TargetName="Time" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="#33FFD65A" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="Time" Property="Foreground" Value="{StaticResource GoldBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" MouseLeftButtonDown="OnDrag">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open OptimAdhan" Click="OnOpen" />
                <MenuItem Header="Widget settings" Click="OnSettings" />
                <Separator />
                <MenuItem x:Name="CompactItem" Header="Compact layout" IsCheckable="True" Click="OnToggleCompact" />
                <MenuItem x:Name="TopItem" Header="Keep above other windows" IsCheckable="True" Click="OnToggleTop" />
                <MenuItem x:Name="LockItem" Header="Lock position" IsCheckable="True" Click="OnToggleLock" />
                <Separator />
                <MenuItem Header="Hide widget" Click="OnHide" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Tint over the acrylic: emerald-to-navy, alpha from the Glass tint setting. -->
        <Border x:Name="Tint">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="TintStart" Color="#E00A2A30" Offset="0" />
                    <GradientStop x:Name="TintMid" Color="#E00B1C3C" Offset="0.55" />
                    <GradientStop x:Name="TintEnd" Color="#E007142D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Soft light from the upper left and a crisp edge highlight: the "liquid glass" sheen. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.7" RadiusY="1.1">
                    <GradientStop Color="#2EFFE9A8" Offset="0" />
                    <GradientStop Color="#00FFE9A8" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- Specular top edge: a thin bright line fading out to both sides. -->
        <Border IsHitTestVisible="False" Height="1" VerticalAlignment="Top" Margin="18,1,18,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#8CFFFFFF" Offset="0.3" />
                    <GradientStop Color="#40FFFFFF" Offset="0.7" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="Edge" IsHitTestVisible="False" BorderThickness="1" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.8" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                    <GradientStop Color="#80FFFFFF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                    <GradientStop Color="#472BB58A" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- ═════════ STANDARD LAYOUT ═════════ -->
        <Grid x:Name="StandardLayout" Width="560" Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: brand | place and date (trims when long) | settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="OptimAdhan" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="#40FFFFFF" Margin="14,0" VerticalAlignment="Center" />
                </StackPanel>
                <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,10,0">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconPin}" Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource ChampagneBrush}"
                          StrokeThickness="1.7" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="12" Foreground="#CCF6F1E7" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding GregorianShort, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ClockShort, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding City}" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationName}" />
                </DockPanel>
                <Button Grid.Column="2" Style="{StaticResource WidgetIconButton}" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Open settings">
                    <Path Data="{StaticResource IconSettings}" Width="16" Height="16" Stretch="Uniform" Stroke="#E6F6F1E7" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- Artwork + next prayer -->
            <Grid Grid.Row="1" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="130" Height="130" VerticalAlignment="Center">
                    <Ellipse Width="128" Height="128" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#40FFC94A" Offset="0" />
                                <GradientStop Color="#00FFC94A" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="118" Height="118" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NEXT PRAYER" Style="{StaticResource Overline}" FontSize="11.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding NextName}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NextArabic}" Style="{StaticResource ArabicText}" FontSize="30" LineHeight="40" Margin="14,4,0,0" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADHAN AT" FontSize="10.5" FontWeight="SemiBold" Foreground="#CCF6F1E7" />
                            <TextBlock Text="{Binding NextTime}" FontSize="22" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#33FFFFFF" Margin="18,4" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STARTS IN" FontSize="10.5" FontWeight="SemiBold" Foreground="#CCF6F1E7" />
                            <TextBlock Text="{Binding NextCountdownCompact}" Style="{StaticResource DisplayText}" FontSize="26" FontWeight="Normal" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ProgressTrack" Height="4" Margin="0,10,0,0">
                        <Border CornerRadius="2" Background="#2EFFFFFF" />
                        <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource GoldBarBrush}" Width="0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Height="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#40FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Five prayers -->
            <ItemsControl Grid.Row="3" Margin="0,8" ItemsSource="{Binding FiveRows}" ItemTemplate="{StaticResource StripItem}" AlternationCount="5" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Grid.Row="4" Height="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#40FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Footer: Ramadan, or useful year-round information -->
            <Grid Grid.Row="5" Margin="2,10,2,0">
                <StackPanel x:Name="RamadanFooter" Orientation="Horizontal" Visibility="{Binding IsRamadan, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{StaticResource IconCrescent}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RamadanDay}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="14,0,0,0" FontSize="12.5" VerticalAlignment="Center" Foreground="#E6F6F1E7">
                        <Run Text="Sehri" Foreground="#B3F6F1E7" /> <Run Text="{Binding SehriTime, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   Iftar" Foreground="#B3F6F1E7" /> <Run Text="{Binding IftarTime, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                        <Run Text="   " /><Run Text="{Binding FastLabel, Mode=OneWay}" Foreground="#B3F6F1E7" /> <Run Text="{Binding FastCountdownCompact, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="InfoFooter" Text="{Binding InfoLine}" FontSize="12.5" Foreground="#D9F6F1E7" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <!-- ═════════ COMPACT LAYOUT ═════════ -->
        <Grid x:Name="CompactLayout" Width="330" Margin="14,10,16,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold">
                    <Run Text="{Binding NextName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding NextTime, Mode=OneWay}" FontWeight="Normal" Foreground="#E6F6F1E7" />
                </TextBlock>
                <TextBlock Text="{Binding City}" FontSize="12" Foreground="#CCF6F1E7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="STARTS IN" FontSize="9.5" FontWeight="SemiBold" Foreground="#CCF6F1E7" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding NextCountdownCompact}" Style="{StaticResource DisplayText}" FontSize="24" FontWeight="Normal" HorizontalAlignment="Right" />
            </StackPanel>
            <Grid x:Name="CompactProgressTrack" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,8,0,0">
                <Border CornerRadius="1.5" Background="#2EFFFFFF" />
                <Border x:Name="CompactProgressFill" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource GoldBarBrush}" Width="0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
