<Window x:Class="OptimAdhan.App.Views.AlertPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimAdhan alert" Width="344" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        Background="Transparent" Foreground="{StaticResource IvoryBrush}" FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True" ThemeMode="None">
    <!-- Same frosted glass as the widget; opaque midnight where system backdrops are unavailable. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Border Background="#EB0B1C3C" />
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.8" RadiusY="1.3">
                    <GradientStop Color="#26FFE9A8" Offset="0" />
                    <GradientStop Color="#00FFE9A8" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="Edge" IsHitTestVisible="False" BorderThickness="1" CornerRadius="8" BorderBrush="#66FFD65A" />

        <StackPanel Margin="16,14,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="34" Height="34" VerticalAlignment="Top" Margin="0,1,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="KindText" Style="{StaticResource Overline}" FontSize="10.5" Text="OptimAdhan" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <!-- Live equaliser while the Adhan plays. -->
                        <Grid x:Name="Equalizer" Width="13" Height="11" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Grid.Resources>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Width" Value="2.5" />
                                    <Setter Property="RadiusX" Value="1.25" />
                                    <Setter Property="RadiusY" Value="1.25" />
                                    <Setter Property="Fill" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                                </Style>
                            </Grid.Resources>
                            <Rectangle x:Name="Bar1" Height="11" HorizontalAlignment="Left"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Bar2" Height="11" HorizontalAlignment="Center"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Bar3" Height="11" HorizontalAlignment="Right"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.65" /></Rectangle.RenderTransform></Rectangle>
                        </Grid>
                        <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ArabicText" Grid.Column="2" Style="{StaticResource ArabicText}" FontSize="26" LineHeight="34"
                           Foreground="{StaticResource GoldBrush}" />
            </Grid>

            <!-- Real playback position; appears once the file's length is known. -->
            <Grid x:Name="Progress" Height="3" Margin="0,12,0,0" Visibility="Collapsed">
                <Border Background="#1FFFFFFF" CornerRadius="1.5" />
                <Border x:Name="ProgressFill" Background="{StaticResource GoldBarBrush}" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
            </Grid>

            <Grid x:Name="Actions" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HideButton" Content="Hide" Click="OnHide" MinHeight="34" FontSize="13" Focusable="False" />
                <Button x:Name="StopButton" Grid.Column="2" Content="Stop Adhan" Click="OnStop" Style="{StaticResource PrimaryButton}" MinHeight="34" FontSize="13" Focusable="False" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
