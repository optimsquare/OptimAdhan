<Window x:Class="OptimAdhan.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OptimAdhan.App.Controls"
        Title="OptimAdhan" Width="1180" Height="800" MinWidth="760" MinHeight="560"
        Icon="pack://application:,,,/Assets/Brand/optimadhan.ico"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{StaticResource IvoryBrush}" FontFamily="{StaticResource TextFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption buttons (custom, because the title bar is part of the design). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Today: one prayer card. States come from PrayerRow.State. -->
        <DataTemplate x:Key="PrayerCardTemplate">
            <Border x:Name="Card" Margin="0,0,12,12" CornerRadius="16" Padding="16,14" BorderThickness="1"
                    Background="{StaticResource CardFillBrush}" BorderBrush="{StaticResource CardStrokeBrush}">
                <StackPanel>
                    <DockPanel>
                        <Path x:Name="Icon" Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource ChampagneBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Border x:Name="Badge" HorizontalAlignment="Right" CornerRadius="9" Padding="8,2" Background="Transparent">
                            <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding Name}" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Arabic}" Style="{StaticResource ArabicText}" FontSize="18" LineHeight="24" HorizontalAlignment="Left" Margin="0,2,0,0" />
                    <TextBlock x:Name="TimeText" Text="{Binding TimeText}" Margin="0,2,0,0" FontFamily="{StaticResource DisplayFont}"
                               FontSize="24" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardStrokeHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.62" />
                    <Setter TargetName="Card" Property="Background" Value="#0AFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#802BB58A" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource EmeraldSoftBrush}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource EmeraldSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource NextCardFillBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#B3FFD65A" />
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource MidnightBrush}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource GoldBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSunrise}" Value="True">
                    <Setter TargetName="TimeText" Property="FontSize" Value="20" />
                    <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Today: one day of the dashboard timetable. Columns match DayTableHeader.
             Rolling: Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha. Ramadan: Sehri ends, Fajr, Dhuhr, Asr, Iftar, Isha. -->
        <DataTemplate x:Key="DayRowTemplate">
            <Border x:Name="Row" Height="32" CornerRadius="9" Padding="14,0" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Dow}" Width="40" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="Tag" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" Background="{StaticResource EmeraldFaintBrush}" VerticalAlignment="Center"
                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="TagText" Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EmeraldSoftBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="T0" Grid.Column="1" Text="{Binding Times[0]}" Style="{StaticResource TimeCell}" />
                    <TextBlock x:Name="T1" Grid.Column="2" Text="{Binding Times[1]}" Style="{StaticResource TimeCell}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Times[2]}" Style="{StaticResource TimeCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Times[3]}" Style="{StaticResource TimeCell}" />
                    <TextBlock x:Name="T4" Grid.Column="5" Text="{Binding Times[4]}" Style="{StaticResource TimeCell}" />
                    <TextBlock Grid.Column="6" Text="{Binding Times[5]}" Style="{StaticResource TimeCell}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRamadan}" Value="True">
                    <Setter TargetName="T0" Property="Foreground" Value="#DCE6FF" />
                    <Setter TargetName="T0" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="T1" Property="Foreground" Value="{StaticResource IvoryBrush}" />
                    <Setter TargetName="T4" Property="Foreground" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="T4" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GoldSoftBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="#8CFFD65A" />
                    <Setter TargetName="Tag" Property="Background" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource MidnightBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PageScroller" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource MidnightBrush}">
        <Grid>
            <Rectangle Fill="{StaticResource WindowGroundBrush}" IsHitTestVisible="False" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════════════ SIDEBAR: expanded, icon rail (c:Shell.IsCompact) or hidden ═════════════ -->
                <Border x:Name="Sidebar" Width="236" ClipToBounds="True" Background="#8C0B1B3A" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,4,14,16">
                        <Button x:Name="PaneButton" DockPanel.Dock="Top" Style="{StaticResource ChromeIconButton}" HorizontalAlignment="Left"
                                Click="OnPaneButton" ToolTip="Collapse navigation" AutomationProperties.Name="Collapse navigation">
                            <Path Data="{StaticResource IconSidebar}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6,0,22">
                            <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OptimAdhan" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                <TextBlock Text="Your Daily Prayer Companion" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="QuickToggles" DockPanel.Dock="Bottom" Style="{StaticResource Inset}" Padding="14,8">
                            <StackPanel>
                                <CheckBox x:Name="SidebarAdhanSwitch" Content="Adhan" Click="OnSidebarAdhan" AutomationProperties.Name="Play the Adhan" />
                                <CheckBox x:Name="SidebarWidgetSwitch" Content="Desktop widget" Click="OnSidebarWidget" AutomationProperties.Name="Show the desktop widget" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="RailToggles" DockPanel.Dock="Bottom" Visibility="Collapsed">
                            <CheckBox x:Name="RailAdhanSwitch" Style="{StaticResource RailToggle}" Tag="{StaticResource IconSpeaker}" Click="OnSidebarAdhan"
                                      AutomationProperties.Name="Play the Adhan" />
                            <CheckBox x:Name="RailWidgetSwitch" Style="{StaticResource RailToggle}" Tag="{StaticResource IconWidget}" Click="OnSidebarWidget"
                                      AutomationProperties.Name="Show the desktop widget" />
                        </StackPanel>

                        <StackPanel x:Name="NavPanel" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <RadioButton x:Name="NavToday" Style="{StaticResource NavItem}" Tag="{StaticResource IconToday}" Content="Today" Checked="OnNav" IsChecked="True" />
                            <RadioButton x:Name="NavMonthly" Style="{StaticResource NavItem}" Tag="{StaticResource IconCalendar}" Content="Monthly times" Checked="OnNav" />
                            <RadioButton x:Name="NavRamadan" Style="{StaticResource NavItem}" Tag="{StaticResource IconCrescent}" Content="Ramadan Imsakia" Checked="OnNav" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="{StaticResource IconSettings}" Content="Settings" Checked="OnNav" />
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="{StaticResource IconInfo}" Content="About" Checked="OnNav" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ═════════════ CONTENT ═════════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TitleRow" Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title bar: drag area, sidebar restore (when hidden), layout tools and caption buttons -->
                    <DockPanel x:Name="TitleBar">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="ViewButton" Style="{StaticResource CaptionButton}" IsTabStop="True" Click="OnViewMenu"
                                    ToolTip="Layout and full screen" AutomationProperties.Name="Layout options">
                                <Path Data="{StaticResource IconLayout}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="FullScreenButton" Style="{StaticResource CaptionButton}" IsTabStop="True" Click="OnToggleFullScreen"
                                    ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen">
                                <Path Data="{StaticResource IconFullScreen}" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Border Width="1" Height="16" Margin="4,0" Background="{StaticResource HairlineBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" AutomationProperties.Name="Minimize">
                                <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            </Button>
                            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" AutomationProperties.Name="Maximize">
                                <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            </Button>
                            <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseWindow" AutomationProperties.Name="Close to tray">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="HiddenNavBar" Orientation="Horizontal" Margin="10,4,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Button x:Name="RestorePaneButton" Style="{StaticResource ChromeIconButton}" Click="OnRestoreSidebar"
                                    ToolTip="Show navigation (Ctrl+B)" AutomationProperties.Name="Show navigation">
                                <Path Data="{StaticResource IconSidebar}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="22" Height="22" Margin="8,0,0,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="OptimAdhan" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="CaptionText" Margin="32,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding TimeZoneNote}" />
                    </DockPanel>

                    <Grid x:Name="Pages" Grid.Row="1">
                        <!-- ═════════════ TODAY ═════════════
                             Scaled up as a whole on large and full-screen displays (TodayScale), never stretched. -->
                        <ScrollViewer x:Name="TodayPage" Style="{StaticResource PageScroller}" SizeChanged="OnTodayViewportChanged">
                            <Grid x:Name="TodayScaleHost">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="TodayScale" ScaleX="1" ScaleY="1" />
                                </Grid.LayoutTransform>
                                <Grid x:Name="TodayContent" Margin="32,4,32,32" MaxWidth="1240">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Click="OnLocationChip" VerticalAlignment="Center" Padding="14,0" ToolTip="Change location"
                                                AutomationProperties.Name="Change location">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPin}" Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource ChampagneBrush}" StrokeThickness="1.6" />
                                                <TextBlock Text="{Binding City}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding ZoneShort}" Margin="8,0,0,0" FontWeight="Normal" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Gregorian}" Style="{StaticResource PageTitle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Hijri}" Foreground="{StaticResource ChampagneBrush}" FontSize="14" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding Clock}" Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Padding="16,12" Background="#26FF9C8A" BorderBrush="#66FF9C8A" BorderThickness="1"
                                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Open settings" Click="OnLocationChip" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <Grid x:Name="HeroRow" Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="SideColumn" Width="300" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Next prayer hero -->
                                        <Border Style="{StaticResource HeroCard}" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle Fill="{StaticResource KhatamPatternBrush}" Opacity="0.05" Width="340" HorizontalAlignment="Right" IsHitTestVisible="False" />
                                                <Grid x:Name="HeroLayout" Margin="30,26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Width="200" Height="200" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <c:ProgressRing Progress="{Binding Progress}" StrokeWidth="8" />
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="STARTS IN" Style="{StaticResource Overline}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding NextCountdown}" Style="{StaticResource DisplayText}" FontSize="38" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="hours : min : sec" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel x:Name="HeroText" Grid.Column="1" Margin="34,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="NEXT PRAYER" Style="{StaticResource Overline}" FontSize="12" />
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding NextName}" FontFamily="{StaticResource DisplayFont}" FontSize="54" FontWeight="SemiBold" Margin="0,0,18,0" />
                                                            <TextBlock Text="{Binding NextArabic}" Style="{StaticResource ArabicText}" FontSize="40" LineHeight="56" Margin="0,8,0,0" />
                                                        </WrapPanel>
                                                        <Border Style="{StaticResource Inset}" Padding="14,8" Margin="0,10,0,0" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Adhan at" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding NextTime}" Margin="10,0,0,0" FontSize="22" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                            </StackPanel>
                                                        </Border>
                                                        <WrapPanel Margin="0,16,0,0">
                                                            <Border x:Name="AdhanPill" CornerRadius="16" Padding="12,0" Height="32" Margin="0,0,10,8" Background="{StaticResource EmeraldFaintBrush}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconSpeaker}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource EmeraldSoftBrush}" StrokeThickness="1.8" />
                                                                    <TextBlock Text="{Binding AdhanStatus}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource EmeraldSoftBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Button x:Name="MuteNextButton" Content="Mute next Adhan" Click="OnMuteNext" Height="32" MinHeight="32" Margin="0,0,10,8" FontWeight="Normal" FontSize="13" />
                                                            <Button x:Name="StopAudioButton" Content="Stop Adhan" Click="OnStopSound" Height="32" MinHeight="32" Margin="0,0,10,8" Style="{StaticResource PrimaryButton}" FontSize="13" Visibility="Collapsed" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding MuteNote}" Style="{StaticResource Caption}" Foreground="{StaticResource ChampagneBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Secondary information -->
                                        <StackPanel x:Name="SidePanel" Grid.Column="1" Margin="16,0,0,0">
                                            <Border Style="{StaticResource Card}" Padding="20">
                                                <StackPanel>
                                                    <TextBlock Text="NOW" Style="{StaticResource Overline}" />
                                                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource SectionTitle}" Margin="0,6,0,4" />
                                                    <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="RamadanCardButton" Margin="0,14,0,0" Padding="0" Click="OnOpenRamadan" HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="Open Ramadan Imsakia">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#4DFFD65A" Background="{StaticResource CardFillBrush}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#99FFD65A" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <TextBlock Text="RAMADAN" Style="{StaticResource Overline}" />
                                                    <StackPanel Visibility="{Binding IsRamadan, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding RamadanDay}" Style="{StaticResource SectionTitle}" />
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Sehri ends" Style="{StaticResource Hint}" />
                                                                <TextBlock Text="{Binding SehriTime}" FontSize="18" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Iftar" Style="{StaticResource Hint}" />
                                                                <TextBlock Text="{Binding IftarTime}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                                                            <Run Text="{Binding FastLabel, Mode=OneWay}" /> <Run Text="{Binding FastCountdown, Mode=OneWay}" Foreground="{StaticResource IvoryBrush}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel x:Name="RamadanTeaserPanel" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding RamadanTeaser}" Style="{StaticResource SectionTitle}" />
                                                        <TextBlock Text="{Binding RamadanTeaserDate}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="View the Imsakia ›" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource GoldBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding TimesHeading}" Style="{StaticResource Overline}" FontSize="12" Margin="0,22,0,0" />
                                    <ItemsControl x:Name="PrayerCards" Grid.Row="3" Margin="0,44,-12,0" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PrayerCardTemplate}"
                                                  Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" Loaded="OnCardsGridLoaded" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!-- Day timetable: from today (or the rest of Ramadan), as many days as fit without scrolling -->
                                    <Border x:Name="DayTableCard" Grid.Row="4" Style="{StaticResource Card}" Padding="8,10,8,10" Margin="0,6,0,14" Visibility="Collapsed">
                                        <StackPanel>
                                            <DockPanel Margin="15,0,6,4">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="DayTableToday" Style="{StaticResource SubtleButton}" Content="Back to today" Click="OnDayTableToday" Margin="0,0,6,0" Padding="10,0"
                                                            Height="28" MinHeight="28" FontSize="12.5" Foreground="{StaticResource GoldBrush}" BorderBrush="#66FFD65A" Visibility="Collapsed" />
                                                    <Button x:Name="DayTableEarlier" Style="{StaticResource ChromeIconButton}" Width="30" Height="28" Click="OnDayTableEarlier"
                                                            ToolTip="Earlier days" AutomationProperties.Name="Earlier days">
                                                        <TextBlock Text="‹" FontSize="18" Margin="0,-3,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                    <Button x:Name="DayTableLater" Style="{StaticResource ChromeIconButton}" Width="30" Height="28" Click="OnDayTableLater"
                                                            ToolTip="Later days" AutomationProperties.Name="Later days">
                                                        <TextBlock Text="›" FontSize="18" Margin="0,-3,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                    <Button x:Name="DayTableLink" Style="{StaticResource SubtleButton}" Content="Full month ›" Click="OnDayTableLink" Margin="10,0,0,0" Padding="8,0"
                                                            Height="28" MinHeight="28" FontSize="12.5" Foreground="{StaticResource GoldBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DayTableTitle" Style="{StaticResource Overline}" FontSize="12" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DayTableRange" Margin="12,0,0,0" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid x:Name="DayTableHeader" Margin="15,0,15,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Overline}">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="{StaticResource ChampagneBrush}" />
                                                        <Setter Property="FontSize" Value="11" />
                                                    </Style>
                                                </Grid.Resources>
                                                <TextBlock Text="DATE" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="Head0" Grid.Column="1" />
                                                <TextBlock x:Name="Head1" Grid.Column="2" />
                                                <TextBlock x:Name="Head2" Grid.Column="3" />
                                                <TextBlock x:Name="Head3" Grid.Column="4" />
                                                <TextBlock x:Name="Head4" Grid.Column="5" />
                                                <TextBlock x:Name="Head5" Grid.Column="6" />
                                            </Grid>
                                            <ItemsControl x:Name="DayTableList" ItemTemplate="{StaticResource DayRowTemplate}" Focusable="False" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="5" Margin="0,4,0,0" Style="{StaticResource Hint}">
                                        <Run Text="{Binding MethodNote, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LocationName, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- ═════════════ MONTHLY ═════════════ -->
                        <Grid x:Name="MonthlyPage" Margin="32,4,32,24" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="‹" FontSize="18" Click="OnPreviousMonth" AutomationProperties.Name="Previous month" />
                                    <Button Content="This month" Click="OnThisMonth" Margin="8,0" BorderBrush="#8CFFD65A" Foreground="{StaticResource GoldBrush}" />
                                    <Button Style="{StaticResource IconButton}" Content="›" FontSize="18" Click="OnNextMonth" AutomationProperties.Name="Next month" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="MonthTitle" Style="{StaticResource PageTitle}" />
                                    <TextBlock x:Name="MonthSubtitle" Style="{StaticResource Caption}" Foreground="{StaticResource ChampagneBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                <DataGrid x:Name="MonthGrid" Style="{StaticResource MidnightGrid}" RowStyle="{StaticResource TableRow}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="1.3*" MinWidth="180">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="DATE" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Dow}" Width="38" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DayNumber}" Width="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                        <Border x:Name="Tag" CornerRadius="9" Padding="8,1" Margin="6,0,0,0" Background="{StaticResource EmeraldFaintBrush}"
                                                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock x:Name="TagText" Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EmeraldSoftBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter TargetName="Tag" Property="Background" Value="{StaticResource GoldBrush}" />
                                                            <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource MidnightBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMonthStart}" Value="True">
                                                            <Setter TargetName="Tag" Property="Background" Value="#24E9CF96" />
                                                            <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource ChampagneBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="HIJRI" Binding="{Binding HijriText}" Width="1.7*" MinWidth="170">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="FAJR" Binding="{Binding Fajr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="SUNRISE" Binding="{Binding Sunrise}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TimeCell}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="DHUHR" Binding="{Binding Dhuhr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="ASR" Binding="{Binding Asr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="MAGHRIB" Binding="{Binding Maghrib}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="ISHA" Binding="{Binding Isha}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock x:Name="TimetableNote" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </Grid>

                        <!-- ═════════════ RAMADAN ═════════════ -->
                        <Grid x:Name="RamadanPage" Margin="32,4,32,24" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource HeroCard}" ClipToBounds="True">
                                <Grid>
                                    <Rectangle Fill="{StaticResource KhatamPatternBrush}" Opacity="0.05" Width="360" HorizontalAlignment="Right" IsHitTestVisible="False" />
                                    <DockPanel Margin="26,22">
                                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Inset}" Padding="16,10" Margin="12,4,0,4" MinWidth="150">
                                                <StackPanel>
                                                    <TextBlock x:Name="RamadanStatusLabel" Style="{StaticResource Hint}" />
                                                    <TextBlock x:Name="RamadanStatusValue" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Inset}" Padding="16,10" Margin="12,4,0,4" MinWidth="150">
                                                <StackPanel>
                                                    <TextBlock Text="Sehri ends" Style="{StaticResource Hint}" />
                                                    <TextBlock x:Name="ImsakSummary" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="RamadanOverline" Style="{StaticResource Overline}" FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="RamadanTitle" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" />
                                                <TextBlock Text="رمضان" Style="{StaticResource ArabicText}" FontSize="32" LineHeight="44" Margin="14,6,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="RamadanSubtitle" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="1" Margin="0,16,0,6">
                                <RadioButton x:Name="AshraAll" Style="{StaticResource Chip}" GroupName="Ashra" Content="All days" IsChecked="True" Checked="OnAshraFilter" />
                                <RadioButton x:Name="Ashra1" Style="{StaticResource Chip}" GroupName="Ashra" Checked="OnAshraFilter">
                                    <TextBlock>Days 1–10 · Mercy  <Run FontFamily="{StaticResource ArabicFont}" FontSize="15" Foreground="{StaticResource ChampagneBrush}">الرحمة</Run></TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="Ashra2" Style="{StaticResource Chip}" GroupName="Ashra" Checked="OnAshraFilter">
                                    <TextBlock>Days 11–20 · Forgiveness  <Run FontFamily="{StaticResource ArabicFont}" FontSize="15" Foreground="{StaticResource ChampagneBrush}">المغفرة</Run></TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="Ashra3" Style="{StaticResource Chip}" GroupName="Ashra" Checked="OnAshraFilter">
                                    <TextBlock>Days 21–30 · Salvation  <Run FontFamily="{StaticResource ArabicFont}" FontSize="15" Foreground="{StaticResource ChampagneBrush}">العتق</Run></TextBlock>
                                </RadioButton>
                            </WrapPanel>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                <DataGrid x:Name="RamadanGrid" Style="{StaticResource MidnightGrid}" RowStyle="{StaticResource TableRow}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="DAY" Width="70" MinWidth="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="{Binding DayBadge}">
                                                        <TextBlock Text="{Binding Day}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="1.4*" MinWidth="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="SEHRI ENDS" Binding="{Binding Sehri}" Width="1.1*" MinWidth="100">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource TimeHeader}">
                                                    <Setter Property="Background" Value="#26789CFF" />
                                                    <Setter Property="Foreground" Value="#C9D8FF" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                    <Setter Property="Background" Value="#14789CFF" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TimeCell}">
                                                    <Setter Property="Foreground" Value="#DCE6FF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="FAJR" Binding="{Binding Fajr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="DHUHR" Binding="{Binding Dhuhr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="ASR" Binding="{Binding Asr}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                        <DataGridTextColumn Header="IFTAR" Binding="{Binding Iftar}" Width="1.1*" MinWidth="100">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource TimeHeader}">
                                                    <Setter Property="Background" Value="#29FFD65A" />
                                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                    <Setter Property="Background" Value="#14FFD65A" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TimeCell}">
                                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ISHA" Binding="{Binding Isha}" Width="*" MinWidth="86" HeaderStyle="{StaticResource TimeHeader}" ElementStyle="{StaticResource TimeCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Dates follow the Umm al-Qura calendar. If your community begins Ramadan by local moonsighting, shift the Hijri date in Settings › Prayer times › Fine-tune and this table moves with it." />
                        </Grid>

                        <!-- ═════════════ SETTINGS ═════════════ -->
                        <ScrollViewer x:Name="SettingsPage" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                            <StackPanel Margin="32,4,32,40" MaxWidth="880" HorizontalAlignment="Left">
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Changes are saved automatically." Style="{StaticResource Hint}" Margin="0,4,0,18" />

                                <Border x:Name="WelcomeBanner" Style="{StaticResource HeroCard}" Padding="22,18" Margin="0,0,0,16">
                                    <DockPanel>
                                        <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="56" Height="56" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Welcome to OptimAdhan" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" FontSize="13.5"
                                                       Text="Choose your location to begin: detect it, or search for your city. Everything else already has sensible defaults." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Location -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="DetectButton" DockPanel.Dock="Right" Click="OnDetectLocation" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPin}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource ChampagneBrush}" StrokeThickness="1.7" />
                                                    <TextBlock Text="Detect my location" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource GoldFaintBrush}" Margin="0,0,14,0">
                                                <Path Data="{StaticResource IconPin}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.7" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CurrentLocationText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="CurrentLocationDetail" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="Or search for a city" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                                        <DockPanel>
                                            <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}" Click="OnSearch" Margin="8,0,0,0" />
                                            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown" AutomationProperties.Name="Search for a city" ToolTip="City, town or address, then press Enter" />
                                        </DockPanel>
                                        <TextBlock x:Name="LocationMessage" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                        <ListBox x:Name="SearchResults" MaxHeight="200" Margin="0,8,0,0" Visibility="Collapsed" DisplayMemberPath="DisplayName"
                                                 MouseDoubleClick="OnUseSearchResult" Background="#33061026" BorderThickness="0" />
                                        <Button x:Name="UseResultButton" Content="Use selected place" Style="{StaticResource PrimaryButton}" Click="OnUseSearchResult"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                                        <Expander Header="Enter coordinates instead" Margin="0,12,0,0">
                                            <WrapPanel Margin="0,10,0,0">
                                                <TextBlock Text="Latitude" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                                                <TextBox x:Name="LatBox" Width="120" AutomationProperties.Name="Latitude" />
                                                <TextBlock Text="Longitude" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                                                <TextBox x:Name="LonBox" Width="120" AutomationProperties.Name="Longitude" />
                                                <Button Content="Apply" Click="OnApplyCoordinates" Margin="12,0,0,0" />
                                            </WrapPanel>
                                        </Expander>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                                   Text="Only place names come from OpenStreetMap. Prayer times are calculated on this PC and work offline." />
                                    </StackPanel>
                                </Border>

                                <!-- Prayer times -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Prayer times" Style="{StaticResource SectionTitle}" />
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="340" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Calculation method" Style="{StaticResource FieldLabel}" />
                                                <TextBlock x:Name="MethodHint" Style="{StaticResource Hint}" Text="Match the method your local masjid uses." />
                                            </StackPanel>
                                            <ComboBox x:Name="MethodBox" Grid.Column="1" SelectionChanged="OnCalculationChanged" VerticalAlignment="Center" AutomationProperties.Name="Calculation method" />
                                        </Grid>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Asr time" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Standard (Shafi, Maliki, Hanbali) or Hanafi, which is later in the afternoon." />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="MadhabStandard" Style="{StaticResource Segment}" GroupName="Madhab" Content="Standard" Checked="OnCalculationChanged" />
                                                    <RadioButton x:Name="MadhabHanafi" Style="{StaticResource Segment}" GroupName="Madhab" Content="Hanafi" Checked="OnCalculationChanged" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Expander Margin="0,18,0,0">
                                            <Expander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Fine-tune" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Hint}" Text="Match your masjid to the minute, adjust the Hijri date, high-latitude rules" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Adjust minutes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Add or subtract minutes from each calculated time." />
                                                <UniformGrid x:Name="AdjustmentsGrid" Columns="6" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                                <Grid Style="{StaticResource SettingsRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="300" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Hijri date" Style="{StaticResource FieldLabel}" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="Shift by a day or two if your community follows local moonsighting." />
                                                    </StackPanel>
                                                    <ComboBox x:Name="HijriOffsetBox" Grid.Column="1" SelectionChanged="OnCalculationChanged" VerticalAlignment="Center" AutomationProperties.Name="Hijri date adjustment" />
                                                </Grid>
                                                <Grid Style="{StaticResource SettingsRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="300" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="High latitudes" Style="{StaticResource FieldLabel}" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="Only matters far north or south, where twilight may not end in summer." />
                                                    </StackPanel>
                                                    <ComboBox x:Name="HighLatBox" Grid.Column="1" SelectionChanged="OnCalculationChanged" VerticalAlignment="Center" AutomationProperties.Name="High-latitude rule" />
                                                </Grid>
                                                <Grid Style="{StaticResource SettingsRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="300" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Polar regions" Style="{StaticResource FieldLabel}" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="Where the sun does not rise or set at all." />
                                                    </StackPanel>
                                                    <ComboBox x:Name="PolarBox" Grid.Column="1" SelectionChanged="OnCalculationChanged" VerticalAlignment="Center" AutomationProperties.Name="Polar regions" />
                                                </Grid>
                                                <WrapPanel x:Name="CustomAnglesPanel" Margin="0,14,0,0">
                                                    <TextBlock Text="Fajr angle" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                                                    <TextBox x:Name="FajrAngleBox" Width="80" LostFocus="OnCalculationChanged" AutomationProperties.Name="Fajr angle" />
                                                    <TextBlock Text="Isha angle" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                                                    <TextBox x:Name="IshaAngleBox" Width="80" LostFocus="OnCalculationChanged" AutomationProperties.Name="Isha angle" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Adhan and sounds -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="AdhanEnabledBox" Click="OnAdhanChanged">
                                            <StackPanel>
                                                <TextBlock Text="Adhan and sounds" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Plays in the background, even with every window closed." />
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Adhan" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="SoundBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnAdhanChanged" Margin="0,4" AutomationProperties.Name="Adhan sound" />
                                            <Button Grid.Column="2" Click="OnTestSound" Margin="8,0,0,0" ToolTip="Preview" AutomationProperties.Name="Preview Adhan">
                                                <StackPanel Orientation="Horizontal"><Path Data="M7,4 L20,12 L7,20 Z" Fill="{StaticResource GoldBrush}" Width="10" Height="12" Stretch="Uniform" /><TextBlock Text="Preview" Margin="8,0,0,0" /></StackPanel>
                                            </Button>
                                            <TextBlock Grid.Row="1" Text="Fajr Adhan" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="FajrSoundBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnAdhanChanged" Margin="0,4" AutomationProperties.Name="Fajr Adhan sound" />
                                            <Button Grid.Row="1" Grid.Column="2" Click="OnTestFajrSound" Margin="8,0,0,0" ToolTip="Preview" AutomationProperties.Name="Preview Fajr Adhan">
                                                <StackPanel Orientation="Horizontal"><Path Data="M7,4 L20,12 L7,20 Z" Fill="{StaticResource GoldBrush}" Width="10" Height="12" Stretch="Uniform" /><TextBlock Text="Preview" Margin="8,0,0,0" /></StackPanel>
                                            </Button>
                                            <TextBlock Grid.Row="2" Text="Volume" Style="{StaticResource FieldLabel}" />
                                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
                                                <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnVolumeChanged"
                                                        VerticalAlignment="Center" AutomationProperties.Name="Adhan volume" SmallChange="5" LargeChange="10" />
                                            </DockPanel>
                                            <Button Grid.Row="2" Grid.Column="2" Content="Stop" Click="OnStopSound" Margin="8,0,0,0" />
                                        </Grid>

                                        <TextBlock Text="Each prayer" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                                        <Border Style="{StaticResource Inset}" Padding="16,4">
                                            <Grid x:Name="PerPrayerGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </Border>
                                        <Button Content="Test the Adhan alert" Click="OnTestAlert" HorizontalAlignment="Left" Margin="0,16,0,0"
                                                ToolTip="Plays the Adhan and shows the alert exactly as it will appear at prayer time." />
                                    </StackPanel>
                                </Border>

                                <!-- Notifications -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="NotificationsBox" Click="OnAdhanChanged" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Prayer reminders" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Show a notification when a reminder you set above is due." />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="QuietFullScreenBox" Click="OnAdhanChanged" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Quiet during full-screen apps and presentations" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Show the alert without sound while a game, video or slideshow is full screen." />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Ramadan -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Ramadan" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="VoiceRemindersBox" Click="OnAdhanChanged" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Spoken Sehri and Iftar countdowns" />
                                                <TextBlock Style="{StaticResource Hint}" Text="15, 10, 5 and 1 minutes before Sehri ends; 10, 5 and 1 minutes before Iftar." />
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Sehri ends" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Imsak: how long before Fajr eating stops." />
                                            </StackPanel>
                                            <ComboBox x:Name="ImsakBox" Grid.Column="1" SelectionChanged="OnCalculationChanged" VerticalAlignment="Center" AutomationProperties.Name="Sehri ends" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Widget -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="WidgetVisibleBox" Click="OnGeneralChanged">
                                            <StackPanel>
                                                <TextBlock Text="Desktop widget" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Drag to move, right-click for options. Hiding it never affects the Adhan." />
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Layout" Style="{StaticResource FieldLabel}" />
                                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="WidgetStandard" Style="{StaticResource Segment}" GroupName="WidgetLayout" Content="Standard" Checked="OnGeneralChanged" />
                                                    <RadioButton x:Name="WidgetCompact" Style="{StaticResource Segment}" GroupName="WidgetLayout" Content="Compact" Checked="OnGeneralChanged" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Glass tint" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Lighter shows more of your wallpaper; darker is easier to read." />
                                            </StackPanel>
                                            <Slider x:Name="WidgetOpacitySlider" Grid.Column="1" Minimum="0.4" Maximum="1" ValueChanged="OnWidgetOpacityChanged" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Widget glass tint" SmallChange="0.05" LargeChange="0.1" />
                                        </Grid>
                                        <CheckBox x:Name="WidgetTopBox" Content="Keep above other windows" Click="OnGeneralChanged" Margin="0,12,0,0" />
                                        <CheckBox x:Name="WidgetLockBox" Content="Lock position" Click="OnGeneralChanged" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Startup & general -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Startup and general" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="StartupBox" Click="OnGeneralChanged" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Start when I sign in to Windows" />
                                                <TextBlock Style="{StaticResource Hint}" Text="Runs quietly in the system tray so the Adhan plays on time." />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="Clock24Box" Content="Use 24-hour clock" Click="OnGeneralChanged" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════════════ ABOUT ═════════════ -->
                        <ScrollViewer x:Name="AboutPage" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                            <StackPanel Margin="32,4,32,40" MaxWidth="680" HorizontalAlignment="Left">
                                <Border Style="{StaticResource HeroCard}" Padding="28">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Brand/symbol.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="OptimAdhan" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                            <TextBlock Text="Your Daily Prayer Companion" FontSize="15" Foreground="{StaticResource ChampagneBrush}" />
                                            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="© Optim Square LLC. All rights reserved." FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                                   Text="Prayer times are calculated on your PC with the open-source adhan algorithms (MIT licence, Batoul Apps), verified against the AlAdhan service. Place search by OpenStreetMap Nominatim (© OpenStreetMap contributors). Time zones from GeoTimeZone. Arabic text in the Amiri font (SIL OFL)." />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                                   Text="Privacy: no accounts and no tracking. Your location stays on this PC; only place-name searches are sent to OpenStreetMap." />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="Open settings folder" Click="OnOpenSettingsFolder" Margin="0,0,8,0" />
                                            <Button Content="Open log folder" Click="OnOpenLogFolder" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Full screen: the only chrome. Fades after a moment; any mouse movement brings it back. -->
                <Border x:Name="FullScreenBar" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0" Visibility="Collapsed">
                    <Button Click="OnToggleFullScreen" Padding="14,0" ToolTip="Exit full screen (Esc or F11)" AutomationProperties.Name="Exit full screen">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExitFullScreen}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource ChampagneBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="Exit full screen" Margin="9,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0" CornerRadius="5" Padding="6,1" Background="#14FFFFFF" BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

